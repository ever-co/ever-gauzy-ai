{
	"name": "gauzy-ai",
	"version": "0.1.0",
	"description": "Ever Gauzy AI — open business services and intelligence platform: APIs and services that gather, analyze and act on business data for the Ever Gauzy ecosystem (job search and AI matching, proposals, screenshot analysis, notifications, scheduling, plugins, AI agents)",
	"private": true,
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"keywords": [],
	"license": "AGPL-3.0-only",
	"homepage": "https://gauzy.co",
	"repository": {
		"type": "git",
		"url": "https://github.com/ever-co/ever-gauzy-ai.git"
	},
	"bugs": {
		"url": "https://github.com/ever-co/ever-gauzy-ai/issues"
	},
	"scripts": {
		"prebuild": "rimraf dist && rimraf tsconfig.tsbuildinfo && rimraf src/schemas/schema.graphql",
		"prepare": "husky",
		"build": "yarn nest build && yarn sdk:generate",
		"build:prod": "yarn nest build && yarn sdk:generate",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "yarn nest start --watch",
		"start:dev": "yarn nest start --watch",
		"start:debug": "yarn nest start --debug --watch",
		"start:prod": "node dist/main",
		"start:online": "yarn cross-env IS_DDB_LOCAL= nest start",
		"seed": "cross-env NODE_ENV=development NODE_OPTIONS=--max_old_space_size=8192 yarn ts-node -r tsconfig-paths/register --project tsconfig.json ./packages/seeds/src/seed.ts",
		"seed:update": "cross-env NODE_ENV=development NODE_OPTIONS=--max_old_space_size=8192 yarn ts-node -r tsconfig-paths/register --project tsconfig.json ./packages/seeds/src/seed-update.ts",
		"sdk:generate": "rimraf sdk/gauzy-ai-sdk.ts && cross-env DB_TYPE=sqljs yarn ts-node -r tsconfig-paths/register src/schema.ts && yarn graphql-codegen --config ./src/schemas/codegen.yml",
		"lint": "eslint \"{src,packages,test}/**/*.ts\"",
		"test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
		"test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
		"test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
		"test:debug": "cross-env NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"prompts:seed": "cross-env TS_NODE_PROJECT=tsconfig.typeorm.json node -r ts-node/register -r tsconfig-paths/register scripts/seed-prompts.ts",
		"trigger:dev": "npx trigger.dev@4 dev",
		"trigger:deploy": "npx trigger.dev@4 deploy",
		"test:e2e": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
		"test:e2e:migrations": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json test/migrations",
		"test:e2e:ephemeral": "node scripts/with-postgres.mjs -- yarn test:e2e:migrations",
		"typeorm": "cross-env TS_NODE_PROJECT=tsconfig.typeorm.json node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d typeorm.config.ts",
		"migration:generate": "node scripts/generate-migration.mjs",
		"migration:generate:ephemeral": "node scripts/with-postgres.mjs -- node scripts/generate-migration.mjs",
		"migration:run": "yarn typeorm migration:run",
		"migration:revert": "yarn typeorm migration:revert",
		"migration:show": "yarn typeorm migration:show",
		"db:ephemeral": "node scripts/with-postgres.mjs --",
		"sls:offline": "yarn sls offline start",
		"sls:deploy": "yarn sls deploy --verbose",
		"sls:package": "yarn sls package",
		"sls:start": "cross-env IS_NOT_SLS= yarn sls offline start",
		"sls:online": "cross-env IS_NOT_SLS= cross-env IS_DDB_LOCAL= yarn sls offline",
		"lint:fix": "eslint \"{src,packages,test}/**/*.ts\" --fix"
	},
	"dependencies": {
		"@apollo/gateway": "^2.14.4",
