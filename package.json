	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"roots": [
			"<rootDir>/src",
			"<rootDir>/packages"
		],
		"testRegex": ".spec.ts$",
		"transform": {
			"^.+\\.(t|j)s$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"moduleNameMapper": {
			"^@packages/entities$": "<rootDir>/packages/entities/index.ts",
			"^@packages/entities/(.*)$": "<rootDir>/packages/entities/src/$1",
			"^@packages/dto$": "<rootDir>/packages/dto/index.ts",
			"^@packages/dto/(.*)$": "<rootDir>/packages/dto/src/$1",
			"^@packages/core$": "<rootDir>/packages/core/index.ts",
			"^@packages/core/(.*)$": "<rootDir>/packages/core/src/$1",
			"^@packages/config$": "<rootDir>/packages/config/index.ts",
			"^@packages/config/(.*)$": "<rootDir>/packages/config/src/$1",
			"^@packages/novu$": "<rootDir>/packages/novu/index.ts",
			"^@packages/novu/(.*)$": "<rootDir>/packages/novu/src/$1",
			"^@packages/ai$": "<rootDir>/packages/ai/index.ts",
			"^@packages/ai/(.*)$": "<rootDir>/packages/ai/src/$1",
			"^@packages/auth$": "<rootDir>/packages/auth/index.ts",
			"^@packages/auth/(.*)$": "<rootDir>/packages/auth/src/$1",
			"^@packages/automationTask$": "<rootDir>/packages/automation-task/index.ts",
			"^@packages/automationTask/(.*)$": "<rootDir>/packages/automation-task/src/$1",
			"^@packages/crawler$": "<rootDir>/packages/crawler/index.ts",
			"^@packages/crawler/(.*)$": "<rootDir>/packages/crawler/src/$1",
			"^@packages/dashboard$": "<rootDir>/packages/dashboard/index.ts",
			"^@packages/dashboard/(.*)$": "<rootDir>/packages/dashboard/src/$1",
			"^@packages/employee$": "<rootDir>/packages/employee/index.ts",
			"^@packages/employee/(.*)$": "<rootDir>/packages/employee/src/$1",
			"^@packages/employeeJobApplication$": "<rootDir>/packages/employee-job-application/index.ts",
			"^@packages/employeeJobApplication/(.*)$": "<rootDir>/packages/employee-job-application/src/$1",
			"^@packages/employeeJobPost$": "<rootDir>/packages/employee-job-post/index.ts",
			"^@packages/employeeJobPost/(.*)$": "<rootDir>/packages/employee-job-post/src/$1",
			"^@packages/health$": "<rootDir>/packages/health/index.ts",
			"^@packages/health/(.*)$": "<rootDir>/packages/health/src/$1",
			"^@packages/jobPost$": "<rootDir>/packages/job-post/index.ts",
			"^@packages/jobPost/(.*)$": "<rootDir>/packages/job-post/src/$1",
			"^@packages/seeds$": "<rootDir>/packages/seeds/index.ts",
			"^@packages/seeds/(.*)$": "<rootDir>/packages/seeds/src/$1",
			"^@packages/sourceConfig$": "<rootDir>/packages/source-config/index.ts",
			"^@packages/sourceConfig/(.*)$": "<rootDir>/packages/source-config/src/$1",
			"^@packages/tenant$": "<rootDir>/packages/tenant/index.ts",
			"^@packages/tenant/(.*)$": "<rootDir>/packages/tenant/src/$1",
			"^@packages/tenantApiKey$": "<rootDir>/packages/tenant-api-key/index.ts",
			"^@packages/tenantApiKey/(.*)$": "<rootDir>/packages/tenant-api-key/src/$1",
			"^@packages/trigger$": "<rootDir>/packages/trigger/index.ts",
			"^@packages/trigger/(.*)$": "<rootDir>/packages/trigger/src/$1",
			"^@packages/ops$": "<rootDir>/packages/ops/index.ts",
			"^@packages/ops/(.*)$": "<rootDir>/packages/ops/src/$1",
			"^@packages/prompts$": "<rootDir>/packages/prompts/index.ts",
			"^@packages/prompts/(.*)$": "<rootDir>/packages/prompts/src/$1",
			"^@packages/user$": "<rootDir>/packages/user/index.ts",
			"^@packages/user/(.*)$": "<rootDir>/packages/user/src/$1",
			"^@packages/core-providers$": "<rootDir>/packages/job-providers/common/index.ts",
			"^@packages/core-providers/(.*)$": "<rootDir>/packages/job-providers/common/src/$1",
			"^@packages/ever-jobs-client$": "<rootDir>/packages/ever-jobs-client/index.ts",
			"^@packages/ever-jobs-client/(.*)$": "<rootDir>/packages/ever-jobs-client/src/$1",
			"^@packages/provider-ever-jobs$": "<rootDir>/packages/job-providers/provider-ever-jobs/index.ts",
			"^@packages/provider-ever-jobs/(.*)$": "<rootDir>/packages/job-providers/provider-ever-jobs/src/$1",
			"^@packages/provider-db$": "<rootDir>/packages/job-providers/provider-db/index.ts",
			"^@packages/provider-db/(.*)$": "<rootDir>/packages/job-providers/provider-db/src/$1",
			"^@packages/provider-upwork$": "<rootDir>/packages/job-providers/provider-upwork/index.ts",
			"^@packages/provider-upwork/(.*)$": "<rootDir>/packages/job-providers/provider-upwork/src/$1",
			"^@packages/plugin$": "<rootDir>/packages/plugin/index.ts",
			"^@packages/plugin/(.*)$": "<rootDir>/packages/plugin/src/$1",
			"^uuid$": "<rootDir>/test/__mocks__/uuid.js",
			"^graphql$": "<rootDir>/node_modules/graphql/index.js",
			"^graphql/(.*)$": "<rootDir>/node_modules/graphql/$1",
			"^@packages/jobSearchCriteria$": "<rootDir>/packages/job-search-criteria/index.ts",
			"^@packages/jobSearchCriteria/(.*)$": "<rootDir>/packages/job-search-criteria/src/$1"
		},
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"testTimeout": 45000,
		"transformIgnorePatterns": [
			"node_modules/(?!(uuid|chalk)/)"
		]
	},
	"lint-staged": {
		"*.ts": [
			"prettier --write"
		]
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"husky": {
		"hooks": {
			"commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
			"pre-commit": "pretty-quick --no-verify --staged"
		}
	},
	"release": {
		"verifyConditions": [
			"@semantic-release/changelog",
			"@semantic-release/npm",
			"@semantic-release/git",
			"@semantic-release/github"
		],
		"prepare": [
			"@semantic-release/changelog",
			"@semantic-release/npm",
			"@semantic-release/git"
		],
		"publish": [
			"@semantic-release/github"
		],
		"generateNotes": {
			"preset": "angular"
		},
		"npmPublish": false
	},
	"prettier": {
		"singleQuote": true
	},
	"engines": {
		"node": ">=26.0.0",
		"yarn": ">=1.22.0"
	},
	"snyk": true
}
