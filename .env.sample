IS_NOT_SLS=true
STAGE=dev
REGION=us-east-1
SERVICE=gauzy-ai

DB_TYPE=postgres
DB_HOST=localhost
DB_USER=postgres
DB_PASS=root
DB_NAME=gauzy_ai
DB_PORT=5432
# PostgreSQL schema is managed by TypeORM migrations, applied at startup (set to false to run `yarn migration:run` yourself)
DB_MIGRATIONS_RUN=true
# Let TypeORM sync the schema from the entities instead of migrations: development only, never in production
DB_SYNCHRONIZE=false

OPENAI_API_KEY=
OPENAI_API_KEY_CURRENT=
OPENAI_ORGANIZATION_ID_CURRENT=
OPENAI_ORGANIZATION_ID=
OPENAI_MODEL=gpt-5.2
OPENAI_MODEL_CURRENT=gpt-5.2

# ── Plugins ──────────────────────────────────────────────────
# Comma-separated plugin names to switch off (see docs/plugins.md and GET /api/plugins), e.g. upwork,source-db
GAUZY_AI_PLUGINS_DISABLED=
# Upwork job source (official API, read-only). Per-tenant credentials belong in source configs (sourceCode "upwork");
# these variables are the fallback. OAuth2 client credentials, or a pre-obtained access token.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_ORGANIZATION_ID=
UPWORK_RESULTS_WANTED=50
UPWORK_TIMEOUT_MS=30000

# ── AI providers ─────────────────────────────────────────────
# OpenRouter (optional; used for scoring/QA through the Vercel AI SDK)
OPENROUTER_API_KEY=
# Screenshot analysis by URL (POST /api/image/process-urls): download limits
IMAGE_FETCH_MAX_BYTES=10485760
IMAGE_FETCH_TIMEOUT_MS=15000
# Vision model for screenshot analysis
OPENAI_VISION_PREVIEW_MODEL=gpt-5.2
# Model used for AI match scoring (OpenRouter model id) and the score threshold
AI_SCORING_MODEL=
AI_MATCH_THRESHOLD=70

# ── Prompt management & observability (Langfuse) ─────────────
# Create a project at https://cloud.langfuse.com (or your own instance), then `yarn prompts:seed` to load the prompt
# catalog (packages/prompts/src/catalog.ts). Without keys the built-in catalog is used.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# AI generation traces are exported to Langfuse whenever the keys are set; set to false to keep only the prompt registry
LANGFUSE_TRACING_ENABLED=true

# ── Notifications (Novu, optional) ───────────────────────────
NOVU_API_KEY=
NOVU_MATCH_NOTIFY_THRESHOLD=80

# ── Scheduling ───────────────────────────────────────────────
# Periodic jobs: crawl, liveness-check, score-pending-matches, daily-digest, cleanup-stale-tasks.
# In-process cron runs them unless LOCAL_CRON_ENABLED=false; unset = on exactly when Trigger.dev is disabled.
# With several API replicas enable it on one replica only (or schedule externally via /api/ops/*).
LOCAL_CRON_ENABLED=
# Intervals must be whole minutes expressible as cron (divisors of 60, or whole hours dividing 24); otherwise set the *_CRON variable.
# Numeric values must be positive (STALE_TASK_TIMEOUT_HOURS may be fractional); an invalid value is an error, never a different schedule.
# The Trigger.dev tasks read the same variables from their own environment: configure it like the API's.
CRAWL_INTERVAL_MINUTES=10
# Searched when no employee has search criteria yet (comma-separated); empty = skip the crawl
CRAWL_DEFAULT_KEYWORDS=
LIVENESS_CHECK_INTERVAL_MINUTES=60
# An open job post is liveness-checked again after this many hours (never-checked posts go first)
LIVENESS_RECHECK_HOURS=24
CRAWL_CRON=
LIVENESS_CRON=
SCORE_PENDING_CRON=15 * * * *
SCORE_PENDING_LIMIT=50
DIGEST_CRON=0 8 * * *
CLEANUP_CRON=0 2 * * *
STALE_TASK_TIMEOUT_HOURS=24
# IANA time zone for the cron expressions (default: server local time in-process, UTC on Trigger.dev)
SCHEDULER_TIMEZONE=
# Token schedulers present as X-SERVICE-TOKEN to /api/ops/* and /api/crawler/* (generate: openssl rand -hex 32)
SERVICE_API_TOKEN=
# Trigger.dev (optional): the tasks in src/trigger run on Trigger.dev workers and call back into this API
TRIGGER_DEV_ENABLED=false
TRIGGER_SECRET_KEY=
# Trigger.dev worker environment (set in the Trigger.dev dashboard, not here): GAUZY_AI_API_URL,
# SERVICE_API_TOKEN, and for tenant tasks a tenant API key as GAUZY_AI_APP_ID / GAUZY_AI_API_KEY.

# ── Authentication ───────────────────────────────────────────
# GraphQL subscriptions re-validate their credentials this often (ms, default 5 min) and close with 4401 when revoked/expired
WS_REVALIDATE_INTERVAL_MS=300000
# Ever ID (OpenID Connect) user sign-in: tokens issued by this issuer are verified against its published keys
# (no shared secret) and mapped to a Gauzy AI user by verified e-mail (Tenant-Id header picks the tenant when
# the user belongs to several). Unset = off; API keys per tenant work without it.
EVER_ID_ISSUER_URL=
# Accepted audiences (comma-separated OAuth client ids); empty = any token of the issuer
EVER_ID_AUDIENCE=
# Secret for the legacy tenant JWT bearer path (optional)
JWT_SECRET=

# Disable Authentication
IS_DISABLE_AUTH=false

# ── Ever Jobs API Integration ────────────────────────────────

# Base URL of the Ever Jobs API (required for Ever Jobs provider)
EVER_JOBS_API_URL=http://localhost:3001

# API key for authenticated access (optional)
EVER_JOBS_API_KEY=

# Request timeout in milliseconds (default: 420000 = 7 minutes)
EVER_JOBS_TIMEOUT=420000

# Comma-separated list of sources to query (default: all non-ATS)
# General boards: linkedin,indeed,glassdoor,zip_recruiter,google,bayt,naukri,
#   bdjobs,internshala,exa,upwork,jobicy,himalayas,remoteok,remotive,arbeitnow,
#   weworkremotely,usajobs,adzuna,reed,jooble,careerjet,dice,simplyhired,
#   wellfound,stepstone,monster,careerbuilder
# ATS platforms: ashby,greenhouse,lever,workable,smartrecruiters,rippling,
#   workday,recruitee,teamtailor,bamboohr,personio,jazzhr,icims,taleo,
#   successfactors,jobvite,adp,ukg
# Company-specific: amazon,apple,microsoft,nvidia,tiktok,uber,cursor
EVER_JOBS_SITES=

# Number of results to request per crawl (default: 50)
EVER_JOBS_RESULTS_WANTED=50

# NOTE: Search parameters (keyword, location, country, isRemote, hoursOld)
# are now managed per-employee via JobSearchCriterion entities in the database.
# See the seed data for examples. The env vars below are no longer used.

